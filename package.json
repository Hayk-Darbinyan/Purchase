{
  "name": "tender-spec-bot",
  "version": "1.0.0",
  "description": "Telegram bot that reads tender/procurement spec sheets (DOCX) and finds matching real products on the Armenian and global market using SerpApi Google AI Mode.",
  "main": "src/bot.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/bot.js",
    "test": "node --test tests/googleAiModeSource.test.js tests/telegramFormatter.test.js tests/zipSpecExtractor.test.js",
    "test:local": "node scripts/testLocal.js tests/fixtures/sample-tender.docx",
    "extract:docx": "node scripts/extractDocxData.js"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "axios": "1.20.0",
    "cheerio": "1.2.0",
    "docx": "^9.7.1",
    "dotenv": "17.4.2",
    "exa-js": "^2.22.0",
    "mammoth": "^1.12.2",
    "node-cron": "^4.6.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.63.0",
    "serpapi": "^2.2.1",
    "telegraf": "4.16.3",
    "winston": "3.19.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
