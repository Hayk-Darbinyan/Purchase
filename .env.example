# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── Search Provider ───────────────────────────────────────────────────────────
# Choose the product/technical-specification search backend.
# Allowed values: serp (default) | exa
PRODUCT_SEARCH_PROVIDER=serp

# SerpApi Google AI Mode API Key (required when PRODUCT_SEARCH_PROVIDER=serp)
SERPAPI_API_KEY=your_serpapi_api_key_here

# Exa API Key (required when PRODUCT_SEARCH_PROVIDER=exa)
# Get your key at https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Bot Settings
MAX_FILE_SIZE_MB=15

# Logging Configuration
LOG_LEVEL=info

# ── Scraper Settings ──────────────────────────────────────────────────────────
# Full URL of the tender listing page to scrape (e.g. e-procurement.am listing)
TENDER_LISTING_URL=https://www.e-procurement.am/hy/public/announcements/list

# Comma-separated list of Armenian keywords for tender name matching
# Tenders whose names contain any of these keywords will be downloaded, normalized, and searched.
KEYWORDS=համակարգիչ

# Comma-separated list of Armenian online store domains used by the Exa provider
# (also used by the scraper for result filtering)
ARMENIAN_STORE_DOMAINS=zigzag.am,vega.am,vesta.am,led.am,vlv.am,aray.am,beko.am,electronicsplanet.am,fine.am,mtech.am,arsiel.am,icenter.am,hardware.am,notebookcentre.am,hiphone.am,pc-electronics.am,vdcomputers.com,megamall.am,electro.am,heraxos.am,itplaza.am,mobax.am,device.am,gagat.am,nout.am,plusstore.am,eldorado.am,onshop.am,vivaelectronics.am,smartbox.am,ph-electronics.am,jetman.am,gt-electronics.am,bork.am,rezon.am,complife.am,allsell.am,3dplanet.am,yerevanmobile.am,notebookmall.am,dgcomp.am

# ── Notifications ────────────────────────────────────────────────────────────
# Telegram chat ID (or @channel_name) that receives automatic scrape notifications.
# Get your chat ID by messaging @userinfobot or checking the Telegram API.
NOTIFY_CHAT_ID=your_chat_id_here
